{
  "name": "corax-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "node packages/corax/scripts/build.mjs",
    "build:core": "node packages/corax/scripts/build.mjs",
    "build:example": "npm run build --workspace examples/basic",
    "dev": "npm run dev --workspace examples/basic",
    "start": "npm run start --workspace examples/basic",
    "pack": "npm run build && node scripts/pack.mjs",
    "release": "npm publish ./artifacts/corax.tgz --access public",
    "test:package": "node --test tests/package/*.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:integration && npm run test:regression",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:regression": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck:packages && npm run typecheck:examples",
    "typecheck:packages": "npm run typecheck --workspace packages/corax --workspace packages/corax-catalog --workspace packages/tracing",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json"
  },
  "dependencies": { "corax": "*" },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0"
}
