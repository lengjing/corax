{
  "name": "corax-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": {
    "packages": ["packages/corax", "packages/corax-catalog", "packages/tracing", "examples/*"],
    "catalog": {
      "@ai-sdk/anthropic": "^4.0.78",
      "@ai-sdk/code-mode": "^1.0.94",
      "@ai-sdk/google": "^4.0.93",
      "@ai-sdk/mcp": "^2.0.73",
      "@ai-sdk/openai": "^4.0.91",
      "@ai-sdk/otel": "^1.0.137",
      "@ai-sdk/provider": "^4.0.26",
      "@ai-sdk/provider-utils": "^5.0.58",
      "@opentelemetry/context-async-hooks": "2.6.1",
      "@opentelemetry/core": "2.6.1",
      "@opentelemetry/sdk-trace-base": "2.6.1",
      "@types/node": "24.13.3",
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3",
      "@vercel/otel": "2.1.3",
      "ai": "^7.0.137",
      "better-auth": "1.6.26",
      "marked": "17.0.6",
      "next": "16.3.4",
      "picocolors": "1.1.1",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "streamdown": "2.5.0",
      "typescript": "7.0.2",
      "vitest": "5.0.2",
      "zod": "4.5.4"
    }
  },
  "trustedDependencies": ["esbuild", "webgpu"],
  "scripts": {
    "setup": "bun install --frozen-lockfile && bun run build",
    "build": "bun packages/corax/scripts/build.mjs",
    "build:core": "bun packages/corax/scripts/build.mjs",
    "build:example": "bun --no-env-file packages/corax/bin/corax.js build --root examples/basic-agent",
    "dev": "bun --no-env-file packages/corax/bin/corax.js dev",
    "start": "bun --no-env-file packages/corax/bin/corax.js start",
    "release": "bun scripts/release.mjs",
    "test:release": "bun test tests/release-smoke.scenario.mjs",
    "test": "bun run build:core && bun test ./tests",
    "typecheck": "bun run typecheck:packages && bun run typecheck:examples",
    "typecheck:packages": "bun run --filter './packages/*' typecheck",
    "typecheck:examples": "bun run tsc --noEmit -p examples/tsconfig.json"
  },
  "dependencies": { "corax": "workspace:*" },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "24.13.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
