{
  "name": "corax-tracing",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral tracing for durable AI agents. Vendored into corax; not published.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "corax-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./delegation": {
      "corax-source": "./src/delegation.ts",
      "types": "./src/delegation.ts",
      "default": "./src/delegation.ts"
    },
    "./otel": {
      "corax-source": "./src/otel.ts",
      "types": "./src/otel.ts",
      "default": "./src/otel.ts"
    },
    "./ai-sdk": {
      "corax-source": "./src/ai-sdk.ts",
      "types": "./src/ai-sdk.ts",
      "default": "./src/ai-sdk.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --maxWorkers=2",
    "test:integration": "vitest run integration.test.ts --maxWorkers=2",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/harness": "1.0.148",
    "@ai-sdk/provider-utils": "5.0.58",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "2.6.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@types/node": "24.13.3",
    "ai": "7.0.137",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "ai": "^7.0.137"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
