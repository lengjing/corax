    "build:types": "bun run build:compiled && bun run tsc -p tsconfig.build.json",
    "check:bin-runtime-dependencies": "bun ./scripts/check-bin-runtime-dependencies.mjs",
    "dev": "bun --no-env-file ./bin/corax.js dev",
